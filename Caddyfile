{$MCP_DOMAIN} {
	# Port 80 is taken by an unrelated system nginx on the host, so it's not
	# mapped into this container (see docker-compose.yml). Getting a cert
	# without it means skipping the HTTP-01 challenge and using TLS-ALPN-01
	# instead, which only needs port 443.
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
	reverse_proxy api:8000
}
