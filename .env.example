# --- PostgreSQL ---
POSTGRES_DB=corpus
POSTGRES_USER=corpus
POSTGRES_PASSWORD=changeme

# Used by the api service (asyncpg driver). Host "db" is the compose service name.
DATABASE_URL=postgresql+asyncpg://corpus:changeme@db:5432/corpus

# --- API auth ---
# Bearer token required on every API endpoint except /health.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=changeme-generate-a-long-random-token

# --- S3-compatible object storage (Hetzner Object Storage) ---
# See https://docs.hetzner.com/storage/object-storage/ for endpoint/region values.
S3_ENDPOINT_URL=https://fsn1.your-objectstorage.com
S3_REGION=fsn1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=comparative-civil-law-pdfs
S3_PRESIGNED_URL_EXPIRY_SECONDS=3600

# --- Web UI (HTTP Basic auth in front of the read-only /ui pages) ---
UI_BASIC_AUTH_USERNAME=admin
# Password for the UI is the same as API_TOKEN above.

# --- SQLAlchemy connection pool (keep small: CPX22 has 2 vCPU / 4 GB RAM) ---
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
