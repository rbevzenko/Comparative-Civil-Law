# --- PostgreSQL ---
POSTGRES_DB=corpus
POSTGRES_USER=corpus
POSTGRES_PASSWORD=changeme

# Used by the api service (asyncpg driver). Host "db" is the compose service name.
DATABASE_URL=postgresql+asyncpg://corpus:changeme@db:5432/corpus

# --- API auth ---
# Bearer token required on every API endpoint except /health.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=changeme-generate-a-long-random-token

# --- S3-compatible object storage (Hetzner Object Storage) ---
# See https://docs.hetzner.com/storage/object-storage/ for endpoint/region values.
S3_ENDPOINT_URL=https://fsn1.your-objectstorage.com
S3_REGION=fsn1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=comparative-civil-law-pdfs
S3_PRESIGNED_URL_EXPIRY_SECONDS=3600

# --- Web UI (/ui/*) ---
# Password-protected login screen, session cookie after that. Two
# independent passwords — either grants access — so each can be handed to
# a different person and rotated without sharing one secret.
# Generate each with: python3 -c "import secrets; print(secrets.token_urlsafe(16))"
UI_PASSWORD_1=changeme-generate-a-random-password
UI_PASSWORD_2=changeme-generate-a-different-random-password
# Signs the session cookie. Generate with:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=changeme-generate-a-long-random-secret

# --- SQLAlchemy connection pool (keep small: CPX22 has 2 vCPU / 4 GB RAM) ---
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# --- Caddy (TLS reverse proxy, required for the Claude.ai remote connector) ---
# Public hostname Caddy requests a Let's Encrypt certificate for. If you
# don't have a domain, <ip-with-dashes>.sslip.io resolves to that IP for
# free with no signup, e.g. 37.27.248.75 -> 37-27-248-75.sslip.io.
MCP_DOMAIN=changeme.sslip.io

# --- MCP server (/mcp) — for adding this corpus as a Claude.ai custom connector ---
# The connector URL is https://<domain>/mcp?token=<this value>. Claude.ai's
# custom-connector dialog has no field for a bearer token, only a URL, so
# the token is part of the URL itself — keep it secret like a password.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_ACCESS_TOKEN=changeme-generate-a-long-random-token
# Optional. Enables real hybrid (vector + full-text) search from the MCP
# search tool by embedding the query with the same model the corpus was
# embedded with (text-embedding-3-small). Without it, MCP search falls back
# to full-text-only.
OPENAI_API_KEY=
