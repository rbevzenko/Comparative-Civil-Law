__pycache__/
*.pyc
.venv/
venv/
.env
*.egg-info/
.pytest_cache/
.DS_Store

# Рабочие каталоги нарезки книг: кэш растров, постраничная модель, OCR.
# Тяжёлые и воспроизводимые — в репозитории лежит только результат.
books/*/cache/
books/*/work/
books/*/ocr/
books/*/source/*.pdf

# Промежуточные файлы выгрузки: несжатые карточки, проекция и список уже
# загруженных external_id. Воспроизводятся из cards.jsonl.gz и профиля.
books/*/output/cards.jsonl
books/*/output/upload.json
books/*/output/uploaded.txt
